{
  "name": "agentg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/database",
    "packages/gateway",
    "packages/telegram",
    "packages/claude-plugin"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "npm run dev:telegram",
    "dev:gateway": "npm --workspace @agentg/gateway run dev",
    "dev:claude": "npm --workspace @agentg/claude-plugin run start",
    "dev:telegram": "npm --workspace @agentg/telegram run dev",
    "build": "npm --workspaces --if-present run build",
    "db:up": "docker compose up -d postgres --quiet-pull",
    "db:down": "docker compose down",
    "db:generate": "npm --workspace @agentg/database run generate",
    "db:migrate": "npm --workspace @agentg/database run migrate",
    "db:ps": "docker compose ps postgres",
    "db:logs": "docker compose logs --tail=50 postgres",
    "backfill:status": "bash scripts/backfill-status.sh",
    "infra:up": "docker compose up -d postgres nats --quiet-pull",
    "compose:telegram": "docker compose --profile container-client up --build telegram",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm --workspaces --if-present run test",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.2.1",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0"
  }
}
