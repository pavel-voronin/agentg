{
  "name": "agentg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/database",
    "packages/gateway",
    "packages/telegram"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "npm run dev:telegram",
    "dev:gateway": "npm --workspace @agentg/gateway run dev",
    "dev:smoke": "npm --workspace @agentg/database run dev:smoke",
    "dev:telegram": "npm --workspace @agentg/telegram run dev",
    "build": "npm --workspace @agentg/database run build && npm --workspace @agentg/gateway run build && npm --workspace @agentg/telegram run build",
    "db:up": "docker compose up -d postgres --quiet-pull",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npm --workspace @agentg/database run migrate",
    "db:ps": "docker compose ps postgres",
    "db:logs": "docker compose logs --tail=50 postgres",
    "infra:up": "docker compose up -d postgres nats --quiet-pull",
    "compose:telegram": "docker compose --profile container-client up --build telegram",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@agentg/database": "file:packages/database",
    "@agentg/shared": "file:packages/shared",
    "@agentg/telegram": "file:packages/telegram",
    "dotenv": "17.4.2",
    "drizzle-orm": "^0.45.2",
    "nats": "^2.29.3",
    "pg": "8.20.0",
    "prebuilt-tdlib": "0.1008063.0",
    "tdl": "8.1.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.6",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "4.1.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.2.1",
    "prettier": "3.8.3",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0",
    "vite": "8.0.10",
    "vitest": "4.1.5"
  }
}
