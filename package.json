{
  "name": "agentg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/database",
    "packages/gateway",
    "packages/control-plane",
    "packages/telegram",
    "packages/summaries",
    "packages/history-sync",
    "packages/claude-plugin"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "npm run dev:telegram",
    "dev:control-plane": "npm --workspace @agentg/control-plane run dev",
    "dev:control-plane-server": "npm --workspace @agentg/control-plane run dev:server",
    "dev:gateway": "npm --workspace @agentg/gateway run dev",
    "dev:history-sync": "npm --workspace @agentg/history-sync run dev",
    "dev:summaries": "npm --workspace @agentg/summaries run dev",
    "dev:claude": "npm --workspace @agentg/claude-plugin run start",
    "dev:telegram": "npm --workspace @agentg/telegram run dev",
    "build": "npm --workspaces --if-present run build",
    "db:up": "docker compose up -d postgres --quiet-pull",
    "db:down": "docker compose down",
    "db:generate": "npm --workspace @agentg/telegram run db:generate && npm --workspace @agentg/history-sync run db:generate && npm --workspace @agentg/summaries run db:generate",
    "db:migrate": "npm --workspace @agentg/telegram run db:migrate && npm --workspace @agentg/history-sync run db:migrate && npm --workspace @agentg/summaries run db:migrate",
    "db:ps": "docker compose ps postgres",
    "db:logs": "docker compose logs --tail=50 postgres",
    "backfill:status": "bash scripts/backfill-status.sh",
    "infra:up": "docker compose up -d postgres nats --quiet-pull",
    "compose:history-sync": "docker compose --profile history-sync up --build history-sync",
    "compose:control-plane": "docker compose --profile control-plane up --build control-plane",
    "compose:summaries": "docker compose --profile summaries up --build summaries",
    "compose:smoke": "node scripts/compose-smoke.mjs",
    "compose:telegram": "docker compose --profile container-client up --build telegram",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm --workspaces --if-present run test",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "source:audit": "node scripts/source-audit.mjs",
    "check": "npm run typecheck && npm run lint && npm run source:audit && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.2.1",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0"
  }
}
