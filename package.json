{
  "name": "agentg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/events",
    "packages/framework",
    "packages/infra",
    "packages/control-plane-sdk",
    "packages/database",
    "packages/service-directory",
    "packages/gateway",
    "packages/control-plane",
    "packages/telegram",
    "packages/tdlib-docs",
    "packages/history-sync",
    "packages/claude-plugin"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:control-plane": "npm --workspace @agentg/control-plane run dev",
    "dev:control-plane-server": "npm --workspace @agentg/control-plane run dev:server",
    "dev:service-directory": "npm --workspace @agentg/service-directory run dev",
    "dev:gateway": "npm --workspace @agentg/gateway run dev",
    "dev:history-sync-control-plane": "npm --workspace @agentg/history-sync run dev:control-plane-assets",
    "dev:history-sync": "npm --workspace @agentg/history-sync run dev",
    "dev:claude": "npm --workspace @agentg/claude-plugin run start",
    "dev:telegram-control-plane": "npm --workspace @agentg/telegram run dev:control-plane-assets",
    "dev:telegram": "npm --workspace @agentg/telegram run dev",
    "telegram:auth": "tsx scripts/telegramAuth.ts",
    "dev:tdlib-docs": "npm --workspace @agentg/tdlib-docs run dev",
    "build": "npm --workspaces --if-present run build",
    "db:up": "docker compose up -d postgres --quiet-pull",
    "db:down": "docker compose down",
    "db:generate": "npm --workspace @agentg/telegram run db:generate && npm --workspace @agentg/history-sync run db:generate",
    "db:migrate": "npm --workspace @agentg/telegram run db:migrate && npm --workspace @agentg/history-sync run db:migrate",
    "db:recreate": "node scripts/dbRecreate.mjs",
    "db:ps": "docker compose ps postgres",
    "db:logs": "docker compose logs --tail=50 postgres",
    "infra:up": "docker compose up -d postgres nats --quiet-pull",
    "compose:history-sync": "docker compose --profile history-sync up --build history-sync",
    "compose:control-plane": "docker compose --profile control-plane up --build control-plane",
    "compose:smoke": "node scripts/composeSmoke.mjs",
    "compose:telegram": "docker compose --profile container-client up --build telegram",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm --workspaces --if-present run test",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "tdlib:docs:generate": "node scripts/tdlibExplorerSchemaGenerate.mjs",
    "tdlib:docs:build": "npm run tdlib:docs:generate && npm --workspace @agentg/tdlib-docs run build",
    "source:audit": "node scripts/sourceAudit.mjs",
    "check": "npm run typecheck && npm run lint && npm run source:audit && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@iconify-json/solar": "^1.2.5",
    "eslint": "10.2.1",
    "prettier": "3.8.3",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0",
    "unplugin-icons": "^23.0.1"
  }
}
