{
  "name": "@agentg/history-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./control-plane": "./src/control-plane/index.ts",
    "./rpc": "./src/rpc/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate-main.ts",
    "build": "vite build",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentg/control-plane-extension": "file:../control-plane-extension",
    "@agentg/database": "file:../database",
    "@agentg/service-directory": "file:../service-directory",
    "@agentg/shared": "file:../shared",
    "@agentg/telegram": "file:../telegram",
    "@trpc/client": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "^0.45.2",
    "nats": "^2.29.3",
    "pg": "8.20.0",
    "vue": "^3.5.33",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "8.15.6",
    "@vitejs/plugin-vue": "^6.0.6",
    "drizzle-kit": "^0.31.10",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vite": "8.0.10",
    "vitest": "4.1.5"
  }
}
