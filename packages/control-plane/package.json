{
  "name": "@agentg/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "vite build --config viteServer.config.ts",
    "dev": "vite --host 127.0.0.1 --port 8788",
    "dev:server": "tsx watch --clear-screen=false src/server/main.ts",
    "preview": "vite preview --host 127.0.0.1 --port 8788",
    "start": "node dist-server/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@agentg/control-plane-sdk": "file:../control-plane-sdk",
    "@agentg/events": "file:../events",
    "@agentg/framework": "file:../framework",
    "@agentg/service-directory": "file:../service-directory",
    "dotenv": "17.4.2",
    "nats": "^2.29.3",
    "pinia": "^3.0.4",
    "vue": "^3.5.33",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "24.10.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "tailwindcss": "^4.2.4",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vite": "8.0.10",
    "vitest": "4.1.5",
    "vue-tsc": "^3.2.7"
  }
}
