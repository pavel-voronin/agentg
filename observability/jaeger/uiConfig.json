{
  "linkPatterns": [
    {
      "type": "tags",
      "key": "rpc.method",
      "url": "http://localhost:3000/d/agentg-operations/agentg-operations?var-rpc_method=#{rpc.method}&from=#{trace.startTime | add -60000000 | epoch_micros_to_date_iso}&to=#{trace.endTime | add 60000000 | epoch_micros_to_date_iso}",
      "text": "Open RPC method metrics in Grafana"
    },
    {
      "type": "tags",
      "key": "telegram.update.type",
      "url": "http://localhost:3000/d/agentg-tdlib-updates/agentg-tdlib-updates?var-update=#{telegram.update.type}&from=#{trace.startTime | add -60000000 | epoch_micros_to_date_iso}&to=#{trace.endTime | add 60000000 | epoch_micros_to_date_iso}",
      "text": "Open TDLib update metrics in Grafana"
    },
    {
      "type": "traces",
      "url": "http://localhost:3000/explore?left=%7B%22datasource%22:%22jaeger%22,%22queries%22:%5B%7B%22query%22:%22#{traceID}%22%7D%5D%7D",
      "text": "Open trace in Grafana"
    }
  ],
  "themes": {
    "enabled": true
  },
  "traceIdDisplayLength": 16,
  "topTagPrefixes": ["rpc.", "db.", "messaging.", "telegram.", "error."]
}
