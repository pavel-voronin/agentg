      "description": "Current number of file download jobs waiting in Postgres. Short spikes are normal after new file discovery; sustained growth means the worker or TDLib cannot keep up.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "mappings": [],
          "noValue": "No telemetry",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
