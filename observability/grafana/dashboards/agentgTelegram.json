          "legendFormat": "last-seen"
        }
      ],
      "title": "Update Catalog And Last Seen",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "telegram_update_type",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Value #A": true
            },
            "renameByName": {
              "telegram_update_type": "Update",
              "handler_status": "Handler Status",
              "Value #B": "Last Seen"
            }
          }
        }
      ],
      "type": "table"
