server {
  listen 8080;
  server_name _;

  access_log /dev/stdout;
  error_log /dev/stderr warn;

  location = /healthz {
    return 204;
  }

  location ^~ /telegram-files/agentg-media/ {
    alias /srv/tdlib-files/agentg-media/;
    autoindex off;
    add_header Cache-Control "private, max-age=3600";
    try_files $uri =404;
  }

  location / {
    return 404;
  }
}
